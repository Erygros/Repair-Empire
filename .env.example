# Server-only PostgreSQL URL. Use the provider's pooled SSL URL on Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/repair_empire?sslmode=require
# Generate a separate cryptographically random secret for each environment.
# Example command: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Exact origin, not an API URL. Production: https://your-domain.example
BETTER_AUTH_URL=http://localhost:3000
